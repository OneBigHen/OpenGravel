{
  "name": "opengravel",
  "version": "0.1.0",
  "private": true,
  "description": "Plan and ride better motorcycle routes with OpenGravel.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "node scripts/dev-demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:architecture": "vitest run --project architecture",
    "ride-sim": "vitest run --project ride-sim --reporter=default --reporter=./tests/ride-sim/pass-fail-reporter.ts",
    "test:real-router": "vitest run --config vitest.realrouter.config.mts",
    "test:e2e:critical": "playwright test --project=critical-chromium",
    "test:watch": "vitest",
    "vendor:maplibre": "node scripts/vendor-maplibre-worker.mjs",
    "verify": "npm run audit:env && npm run lint && npm run typecheck && npm test && npm run build",
    "audit:env": "node scripts/qa/audit-env-example.mjs",
    "audit:production-env": "node scripts/qa/audit-production-env.mjs",
    "css:budget": "node scripts/qa/css-budget.mjs",
    "shots": "node scripts/og-shots/index.mjs",
    "catalog:trails": "node --import tsx infra/trails/build-trails.ts",
    "scorecard": "node --conditions=react-server --import tsx scripts/scorecard/run.ts",
    "scorecard:combine": "node --conditions=react-server --import tsx scripts/scorecard/combine-cli.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "dexie": "^4.4.7",
    "hls.js": "^1.7.3",
    "maplibre-gl": "^6.10.0",
    "next": "16.4.1",
    "pmtiles": "^4.5.0",
    "posthog-js": "^1.435.8",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "vite": "^8.3.3",
    "dompurify": "^3.4.17",
    "zod": "^4.6.6",
    "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.1" },
    "uuid": "^11.1.1"
  }
}
