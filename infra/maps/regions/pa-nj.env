# PA/NJ HD-map pilot. Source this from the scripts in ../scripts.
REGION_ID=pa-nj
REGION_NAME="Pennsylvania + New Jersey"

# Conservative envelope for raster/Overture extraction and artifact metadata.
BBOX_WEST=-80.60
BBOX_SOUTH=38.85
BBOX_EAST=-73.80
BBOX_NORTH=42.35

OSM_URL_PA=https://download.geofabrik.de/north-america/us/pennsylvania-latest.osm.pbf
OSM_URL_NJ=https://download.geofabrik.de/north-america/us/new-jersey-latest.osm.pbf

# Pin map compiler versions; do not silently follow latest in repeatable builds.
PLANETILER_IMAGE=ghcr.io/onthegomap/planetiler:0.10.2
PLANETILER_HEAP=24g
VECTOR_MAXZOOM=15
