{
  "priority": [
    {
      "if": "og_curve < 0.15 && road_class != MOTORWAY",
      "multiply_by": "0.5"
    },
    {
      "if": "og_curve < 0.4",
      "multiply_by": "0.75"
    },
    {
      "if": "urban_density != RURAL",
      "multiply_by": "0.6"
    },
    {
      "if": "road_class == RESIDENTIAL || road_class == SERVICE",
      "multiply_by": "0.5"
    }
  ]
}
