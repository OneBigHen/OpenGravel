{
  "distance_influence": 60,
  "priority": [
    { "if": "!car_access", "multiply_by": "0" },
    { "if": "track_type.ordinal() > 1", "multiply_by": "0" },
    { "if": "road_access == PRIVATE", "multiply_by": "0" },
    { "if": "road_access == DESTINATION", "multiply_by": "0.1" },
    { "if": "toll == ALL", "multiply_by": "0.2" },
    { "if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0.1" },
    { "else_if": "road_class == PRIMARY", "multiply_by": "0.5" },
    { "else_if": "road_class == RESIDENTIAL || road_class == SERVICE || road_class == LIVING_STREET", "multiply_by": "0.4" },
    { "if": "urban_density == CITY", "multiply_by": "0.5" },
    { "else_if": "urban_density == RESIDENTIAL", "multiply_by": "0.8" },
    { "if": "og_curve == 0", "multiply_by": "0.35" },
    { "else_if": "og_curve < 0.25", "multiply_by": "0.7" },
    { "else_if": "og_curve < 0.5", "multiply_by": "0.85" }
  ],
  "speed": [
    { "if": "true", "limit_to": "car_average_speed" },
    { "if": "true", "limit_to": "120" },
    {
      "if": "surface == COBBLESTONE || surface == GRASS || surface == GRAVEL || surface == SAND || surface == PAVING_STONES || surface == DIRT || surface == GROUND || surface == UNPAVED || surface == COMPACTED",
      "limit_to": "30"
    }
  ]
}
