# Public URL used in metadata. The local default is http://localhost:3000.
OGV_PUBLIC_ORIGIN=

# Routing service reachable by this server. A local GraphHopper instance is the default.
GRAPHHOPPER_URL=http://127.0.0.1:8989
GRAPHHOPPER_API_KEY=

# Optional self-hosted Photon URL. Without it, the public Photon service is used.
PHOTON_URL=
# Optional search hint in latitude,longitude order. No region is assumed by default.
OGV_GEOCODER_BIAS=

# Optional Mapbox public token. This value is visible to browsers; use a restricted pk token only.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional nearby-places service. Configure both values on the server.
OGV_PLACES_API_URL=
OGV_PLACES_API_KEY=

# Optional advisor provider credentials. Keep these server-side.
ADVISOR_API_KEY=
ADVISOR_ENDPOINT=
ADVISOR_MODEL=
ADVISOR_FALLBACK_API_KEY=
ADVISOR_FALLBACK_ENDPOINT=
ADVISOR_FALLBACK_MODEL=

# Traffic camera overlay. When enabled without a state list, OpenGravel
# supports PA, NJ, NY, DE, MD, VA, WV and OH and only contacts states intersecting
# the current map view. OH requires OHGO_API_KEY. PA511_CAMERAS_ENABLED remains
# as a backwards-compatible PA-only switch for existing personal deployments.
TRAFFIC_CAMERAS_ENABLED=0
TRAFFIC_CAMERAS_STATES=PA,NJ,NY,DE,MD,VA,WV,OH

# Optional nationwide fallback. OpenGravel reads StormScope's small camera index
# and only the geographic shards intersecting the current view. Dedicated state
# adapters still win; this is used when no dedicated adapter exists or all fail.
STORMSCOPE_CAMERAS_ENABLED=0
# Override for a self-hosted/mirrored StormScope data directory if desired.
STORMSCOPE_CAMERA_BASE_URL=

OHGO_API_KEY=

# Optional same-origin relay for direct state HLS streams (NJ/DE/MD/VA/WV).
# It also serves as the default PA relay secret unless the PA-specific secret
# below is set. Use a private random value of at least 24 characters.
TRAFFIC_CAMERA_VIDEO_PROXY_SECRET=
PA511_CAMERAS_ENABLED=0

# Experimental in-card live HLS for the selected 511PA camera. Native HLS
# playback is targeted first (iPhone/iPad/Safari). Generate a private random
# secret of at least 24 characters; it encrypts short-lived relay resource URLs.
PA511_VIDEO_ENABLED=0
PA511_VIDEO_PROXY_SECRET=
