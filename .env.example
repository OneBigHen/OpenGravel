# OpenGravel deployment environment
#
# Copy to .env.local for development or load equivalent values through the
# production process manager/secret store. Blank optional values keep the
# associated capability disabled or on its documented fallback.
#
# Never enable OGV_*_FIXTURE variables in production.

# ---------------------------------------------------------------------------
# Runtime identity / public origin
# ---------------------------------------------------------------------------

# Exact public HTTPS origin used for metadata and OAuth callbacks.
# Local development: http://localhost:3000
OGV_PUBLIC_ORIGIN=

# Optional deployment prefix, e.g. /opengravel. Leave blank for origin root.
NEXT_PUBLIC_BASE_PATH=

# Basemap: mapbox | openfreemap | osm | empty.
# Blank selects Mapbox when a valid public token exists, otherwise OpenFreeMap.
NEXT_PUBLIC_OGV_BASEMAP=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Secrets-free values exposed by /api/health. policyVersion comes from code;
# OGV_POLICY_VERSION is obsolete and must not override the routing policy.
OGV_BUILD_ID=
OGV_GRAPH_VERSION=

# ---------------------------------------------------------------------------
# Routing
# ---------------------------------------------------------------------------

# Local/self-hosted GraphHopper remains primary.
GRAPHHOPPER_URL=http://127.0.0.1:8989

# Optional hosted GraphHopper fallback for supported requests.
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_HOSTED_DAILY_BUDGET=

# ---------------------------------------------------------------------------
# Geocoding / maps / map data
# ---------------------------------------------------------------------------

# Optional self-hosted Photon URL. Blank uses public Photon.
# Valhalla has no production adapter in this checkout; no env enables it.
PHOTON_URL=
# Optional latitude,longitude search bias.
OGV_GEOCODER_BIAS=

# TomTom is used for live traffic and current stop/map POI adapters.
# TOMTOM_TRAFFIC_API_KEY may be separate; otherwise TOMTOM_API_KEY is reused.
TOMTOM_API_KEY=
TOMTOM_TRAFFIC_API_KEY=

# Optional Overpass endpoint. Blank uses the bounded mirror list in code.
OVERPASS_URL=

# Local known-road catalogues. Missing files preserve graceful routing fallback.
# /api/health providers reports missing vs invalid vs valid empty catalogues.
CURVATURE_DB_PATH=
GRAVEL_ATLAS_DB_PATH=

# ---------------------------------------------------------------------------
# Weather / Discover
# ---------------------------------------------------------------------------

# Identify this deployment to public APIs. Use a real contact for production.
NWS_USER_AGENT="OpenGravel/0.1 (contact@example.com)"
WIKIMEDIA_USER_AGENT="OpenGravel/0.1 (contact@example.com)"

# Built OSM Discover index. See infra/discover/build-osm-places.*
OGV_DISCOVER_OSM_PLACES=
# Optional local Overture Places index (pinned regional GeoParquet extract).
OGV_DISCOVER_OVERTURE_PLACES=

# ---------------------------------------------------------------------------
# Road authority / closures / seasonal access
# ---------------------------------------------------------------------------

# Off by default. Set exactly "on" to enable normalized road-authority checks.
OGV_ROAD_AUTHORITY=off

# Fun-route candidate generators (routing research). "off" (default) never
# runs; "shadow" runs after the plan answered and only logs a diagnostic report;
# "on" merges eligible generated routes into ranking (research only).
OGV_FUN_GENERATORS=off
# Extra provider calls the family may spend per plan (max 8).
OGV_FUN_GENERATORS_CALLS=2
# Wall-clock budget for the family per plan, in milliseconds (max 30000).
OGV_FUN_GENERATORS_DEADLINE_MS=12000
# "fixed" round-robin or "adaptive" marginal-regret call allocation.
OGV_FUN_GENERATORS_ALLOCATION=fixed
# Persistent cache directory for authority source artifacts.
OGV_ROAD_AUTHORITY_CACHE_DIR=
# Optional Pennsylvania Turnpike WZDx feed credential.
PTC_WZDX_API_KEY=

# ---------------------------------------------------------------------------
# Places / events
# ---------------------------------------------------------------------------

# Optional generic nearby-places service. Current main requires both.
OGV_PLACES_API_URL=
OGV_PLACES_API_KEY=
# Events feed (events.henning.rodeo) for Explore Things / Along this ride.
OGV_EVENTS_API_URL=https://events.henning.rodeo
OGV_EVENTS_API_KEY=

# OGV_EVENTS_API_URL/KEY are not read in this checkout; use the Places contract.

# ---------------------------------------------------------------------------
# Advisor / optional model-backed classifiers
# ---------------------------------------------------------------------------

# The advisor uses an OpenAI-compatible endpoint. Any one primary key below can
# enable it; OpenRouter endpoint/model have safe code defaults.
ADVISOR_API_KEY=
ADVISOR_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
ADVISOR_ENDPOINT=
ADVISOR_MODEL=
OPENROUTER_MODEL=

# Optional operational fallback: all three values are required.
ADVISOR_FALLBACK_API_KEY=
ADVISOR_FALLBACK_ENDPOINT=
ADVISOR_FALLBACK_MODEL=

# Optional bounded Jev ride-character classifier. It must never establish
# geometry, legality, access, closures, or hard eligibility.
JEV_API_KEY=
# FUN JUDGE for Best Ride: off (default) | shadow | on. `shadow` asks Jev and
# reports its pick in plan diagnostics only; `on` lets a confident Jev pick
# become Best Ride among eligible routes inside the detour/time budget. Never
# decides legality, access, closures or geometry. Keep off in production until
# held-out evidence justifies promotion.
OGV_JEV_FUN_JUDGE=
# Offline research only (scripts/jev-frontier-replay.ts): opt-in flag ("1") and
# provider ("openrouter" default, or "typesafe" with JEV_API_KEY).
OGV_JEV_FRONTIER_SHADOW=
OGV_JEV_FRONTIER_PROVIDER=

# ---------------------------------------------------------------------------
# Offline maps / routing
# ---------------------------------------------------------------------------

# Published road-graph regions; default data/offline-regions.
OGV_OFFLINE_REGION_ROOT=
# PMTiles basemap archives; default data/basemap.
OGV_BASEMAP_ROOT=

# ---------------------------------------------------------------------------
# Sharing / community / feedback
# ---------------------------------------------------------------------------

# Persistent public snapshots. Default data/public-shares.sqlite.
OGV_SHARE_DB_PATH=

# Shared community/rating/contribution database. Default data/community.sqlite.
COMMUNITY_DB_PATH=
# Compatibility alias used only when COMMUNITY_DB_PATH is unset.
OGV_CONTRIBUTIONS_DB_PATH=
# Required only for moderation queue/decision endpoints.
OGV_MODERATION_TOKEN=

# Rider feedback database. Default data/feedback.sqlite.
OGV_FEEDBACK_DB_PATH=

# ---------------------------------------------------------------------------
# Spotify
# ---------------------------------------------------------------------------

# Comma-separated exact public origins allowed to receive Spotify callbacks.
OGV_SPOTIFY_ALLOWED_ORIGINS=
# Public Spotify app client ID; no Spotify client secret is used.
SPOTIFY_CLIENT_ID=
# Private 32-byte session encryption key. Generate: openssl rand -hex 32
OGV_SPOTIFY_SESSION_KEY=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------

# Blank/unrecognized = self-host/off. "hosted-beta" enables the consent mode,
# but current main still requires a separately bound analytics transport.
NEXT_PUBLIC_TELEMETRY_MODE=

# ---------------------------------------------------------------------------
# Public-origin security
# ---------------------------------------------------------------------------

# Optional fail2ban/shared blocklist path. Default: /var/lib/opengravel/banned-ips.txt
OGV_BLOCKLIST_PATH=

# Trust Cloudflare's cf-connecting-ip only when the origin is actually
# firewalled so requests cannot bypass Cloudflare and spoof this header.
TRUST_CF_CONNECTING_IP=0

# ---------------------------------------------------------------------------
# Traffic cameras
# ---------------------------------------------------------------------------

# When enabled without a state list, adapters support PA/NJ/NY/DE/MD/VA/WV/OH.
TRAFFIC_CAMERAS_ENABLED=0
TRAFFIC_CAMERAS_STATES=PA,NJ,NY,DE,MD,VA,WV,OH
OHGO_API_KEY=

# Optional nationwide fallback. Dedicated state adapters win.
STORMSCOPE_CAMERAS_ENABLED=0
STORMSCOPE_CAMERA_BASE_URL=

# Same-origin relay secret for direct state HLS. At least 24 random characters.
TRAFFIC_CAMERA_VIDEO_PROXY_SECRET=

# PA compatibility/discovery switch and optional PA live-HLS relay.
PA511_CAMERAS_ENABLED=0
PA511_VIDEO_ENABLED=0
PA511_VIDEO_PROXY_SECRET=

# Exact HTTPS camera media origins. Wildcards/redirects/private addresses are
# rejected by the runtime security policy.
TRAFFIC_CAMERA_ALLOWED_ORIGINS_PA=
TRAFFIC_CAMERA_ALLOWED_ORIGINS_NJ=
TRAFFIC_CAMERA_ALLOWED_ORIGINS_NY=
TRAFFIC_CAMERA_ALLOWED_ORIGINS_DE=
TRAFFIC_CAMERA_ALLOWED_ORIGINS_MD=
TRAFFIC_CAMERA_ALLOWED_ORIGINS_VA=
TRAFFIC_CAMERA_ALLOWED_ORIGINS_WV=

# Separate exact metadata origins used when a state adapter must fetch metadata
# from an origin that is not itself an allowed media origin.
TRAFFIC_CAMERA_METADATA_ORIGINS_PA=
TRAFFIC_CAMERA_METADATA_ORIGINS_NJ=
TRAFFIC_CAMERA_METADATA_ORIGINS_NY=
TRAFFIC_CAMERA_METADATA_ORIGINS_DE=
TRAFFIC_CAMERA_METADATA_ORIGINS_MD=
TRAFFIC_CAMERA_METADATA_ORIGINS_VA=
TRAFFIC_CAMERA_METADATA_ORIGINS_WV=

# ---------------------------------------------------------------------------
# Native iOS build
# ---------------------------------------------------------------------------

# Optional remote web origin loaded by the Capacitor iOS shell. Leave blank
# when packaging bundled web assets. When set, use the intended HTTPS origin.
CAPACITOR_SERVER_URL=

# ---------------------------------------------------------------------------
# Test/demo fixtures — DO NOT SET IN PRODUCTION
# ---------------------------------------------------------------------------
# OGV_ROUTE_PLAN_FIXTURE=1
# OGV_WEATHER_FIXTURE=1
# OGV_GEOCODE_FIXTURE=1
# OGV_PLACES_FIXTURE=1
# OGV_MAP_LAYERS_FIXTURE=1
# OGV_ELEVATION_FIXTURE=1
# OGV_CATALOG_FIXTURE=1
# OGV_ADVISOR_FIXTURE=1
# NEXT_PUBLIC_OGV_RIDE_FIXTURE=1
# OGV_ROUTE_PLAN_FIXTURE_DELAY_MS=

# E2E runner only: isolated server port and optional WebKit lane.
# OGV_E2E_PORT=
# OGV_E2E_WEBKIT=1

# NASA FIRMS VIIRS SNPP NRT hotspots for the Active fire map layer (server only).
NASA_FIRMS_MAP_KEY=
