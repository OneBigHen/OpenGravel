# Public URL used in metadata. The local default is http://localhost:3000.
OGV_PUBLIC_ORIGIN=

# Routing service reachable by this server. A local GraphHopper instance is the default.
GRAPHHOPPER_URL=http://127.0.0.1:8989
GRAPHHOPPER_API_KEY=

# Optional self-hosted Photon URL. Without it, the public Photon service is used.
PHOTON_URL=
# Optional search hint in latitude,longitude order. No region is assumed by default.
OGV_GEOCODER_BIAS=

# Optional Mapbox public token. This value is visible to browsers; use a restricted pk token only.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional nearby-places service. Configure both values on the server.
OGV_PLACES_API_URL=
OGV_PLACES_API_KEY=

# Optional advisor provider credentials. Keep these server-side.
ADVISOR_API_KEY=
ADVISOR_ENDPOINT=
ADVISOR_MODEL=
ADVISOR_FALLBACK_API_KEY=
ADVISOR_FALLBACK_ENDPOINT=
ADVISOR_FALLBACK_MODEL=

# Personal/self-hosted traffic camera overlay. Uses the public 511PA camera
# catalogue; keep disabled on shared/public deployments unless you intend to
# operate the adapter and accept the upstream usage constraints.
PA511_CAMERAS_ENABLED=0

# Experimental in-card live HLS for the selected 511PA camera. Native HLS
# playback is targeted first (iPhone/iPad/Safari). Generate a private random
# secret of at least 24 characters; it encrypts short-lived relay resource URLs.
PA511_VIDEO_ENABLED=0
PA511_VIDEO_PROXY_SECRET=
